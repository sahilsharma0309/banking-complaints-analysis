# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env
# `.env` is gitignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- PostgreSQL (Stage 4: load + SQL analysis) -----------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=banking_complaints
PGUSER=postgres
PGPASSWORD=

# Full path to psql.exe. Used for the fast \copy bulk-load path on Windows.
# Typical: C:\Program Files\PostgreSQL\<version>\bin\psql.exe
PSQL_BIN=C:\Program Files\PostgreSQL\18\bin\psql.exe

# --- CFPB Consumer Complaint Database (Stage 1) ----------------------------
# Public API, no key required. These bound the extract.
CFPB_DATE_FROM=2023-01-01
CFPB_DATE_TO=2026-01-01

# --- FRED (Stage 3, OPTIONAL macro enrichment) -----------------------------
# Free key: https://fredaccount.stlouisfed.org/apikeys
# Leave blank to skip the macro-correlation step entirely.
FRED_API_KEY=

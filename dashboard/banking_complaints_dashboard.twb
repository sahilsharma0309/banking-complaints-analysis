          </filter>
          <filter class='quantitative' column="[federated.company_summary_ds1].[none:complaints_per_1b_assets:qk]" included-values='non-null' />
          <filter class='categorical' column="[federated.company_summary_ds1].[none:is_fdic_matched:nk]">
            <groupfilter function='member' level='[none:is_fdic_matched:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <sort class='computed' column="[federated.company_summary_ds1].[none:company:nk]" direction='DESC' using="[federated.company_summary_ds1].[avg:complaints_per_1b_assets:qk]" />

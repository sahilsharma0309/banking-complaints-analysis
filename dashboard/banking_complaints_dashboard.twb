  <worksheets>
    <worksheet name='1. Size-Adjusted Risk'>
      <table>
        <view>
          <datasources>
            <datasource caption='company_summary' name='federated.company_summary_ds1' />
          </datasources>
          <datasource-dependencies datasource='federated.company_summary_ds1'>
            <column-instance column='[complaints_per_1b_assets]' derivation='Avg' name='[avg:complaints_per_1b_assets:qk]' pivot='key' type='quantitative' />
            <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
            <column caption='Complaints Per 1b Assets' datatype='real' name='[complaints_per_1b_assets]' role='measure' type='quantitative' />
            <column caption='Is Fdic Matched' datatype='boolean' name='[is_fdic_matched]' role='dimension' type='nominal' />
            <column-instance column='[company]' derivation='None' name='[none:company:nk]' pivot='key' type='nominal' />
            <column-instance column='[complaints_per_1b_assets]' derivation='None' name='[none:complaints_per_1b_assets:qk]' pivot='key' type='quantitative' />
            <column-instance column='[is_fdic_matched]' derivation='None' name='[none:is_fdic_matched:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank_gap]' derivation='None' name='[none:rank_gap:qk]' pivot='key' type='quantitative' />
            <column caption='Rank Gap' datatype='real' name='[rank_gap]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.company_summary_ds1].[none:company:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='MAX([complaints_per_1b_assets])' function='order' user:ui-marker='order'>
                <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;ALLY FINANCIAL INC.&quot;' />
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;AMERICAN EXPRESS COMPANY&quot;' />
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;BANK OF AMERICA, NATIONAL ASSOCIATION&quot;' />
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;BARCLAYS BANK DELAWARE&quot;' />
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;BMO BANK NATIONAL ASSOCIATION&quot;' />
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;CAPITAL ONE FINANCIAL CORPORATION&quot;' />
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;CITIBANK, N.A.&quot;' />
                  <groupfilter function='member' level='[none:company:nk]' member='&quot;CITIZENS FINANCIAL GROUP, INC.&quot;' />

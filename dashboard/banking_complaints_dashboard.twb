                  <groupfilter function='member' level='[none:company:nk]' member='"SYNCHRONY FINANCIAL"' />
                  <groupfilter function='member' level='[none:company:nk]' member='"TD BANK US HOLDING COMPANY"' />
                  <groupfilter function='member' level='[none:company:nk]' member='"TRUIST FINANCIAL CORPORATION"' />
                  <groupfilter function='member' level='[none:company:nk]' member='"U.S. BANCORP"' />
